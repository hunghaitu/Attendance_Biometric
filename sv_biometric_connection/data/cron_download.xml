<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="0">

        <record id="ir_cron_sync_attendance_today" model="ir.cron">
            <field name="name">Sync ZK Attendance to HR Attendance</field>
            <field name="model_id" ref="model_biometric_device_details"/>
            <field name="state">code</field>
            <field name="code">model.cron_queue_sync_attendance()</field>
            <field name="interval_number">60</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_queue_download_attendance" model="ir.cron">
            <field name="name">[Queue Job] Download Attendance From All Devices</field>
            <field name="model_id" ref="model_biometric_device_details"/>
            <field name="state">code</field>
            <field name="code">model.cron_queue_download_attendance()</field>
            <field name="interval_number">60</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>


        <record id="ir_cron_sync_attendance__yesterday_today" model="ir.cron">
            <field name="name">Sync ZK Attendance to HR Attendance Yesterday</field>
            <field name="model_id" ref="model_biometric_device_details"/>
            <field name="state">code</field>
            <field name="code">model.cron_queue_sync_attendance_yesterday_today()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_queue_download_attendance_last_day" model="ir.cron">
            <field name="name">[Queue Job] Download Attendance From All Devices Yesterday</field>
            <field name="model_id" ref="model_biometric_device_details"/>
            <field name="state">code</field>
            <field name="code">model.cron_queue_download_attendance_last_day()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_cleanup_queue_job_stuck" model="ir.cron">
            <field name="name">Queue Job: Cleanup Stuck 'Started' Jobs</field>
            <field name="model_id" ref="queue_job.model_queue_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_stuck_jobs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
