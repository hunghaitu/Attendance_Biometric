#. module: sv_biometric_connection
#: model_terms:ir.ui.view,arch_db:sv_biometric_connection.biometric_device_details_form_view
msgid ""
"<strong>DNS Domain Connection:</strong>\n"
"                            <br/>\n"
"                            Use this when all devices are accessible through the same DNS domain.\n"
"                            <br/>\n"
"                            Example: company.ddns.net"
msgstr ""
"<strong>Kết nối DNS Domain:</strong>\n"
"                            <br/>\n"
"                            Sử dụng khi tất cả thiết bị có thể truy cập qua cùng một tên miền DNS.\n"
"                            <br/>\n"
"                            Ví dụ: company.ddns.net"

#. module: sv_biometric_connection
#: model_terms:ir.ui.view,arch_db:sv_biometric_connection.biometric_device_details_form_view
msgid ""
"<strong>Direct IP Connection:</strong>\n"
"                            <br/>\n"
"                            Use this when you know the exact IP address of the device.\n"
"                            <br/>\n"
"                            Example: 192.168.1.100"
msgstr ""
"<strong>Kết nối IP trực tiếp:</strong>\n"
"                            <br/>\n"
"                            Sử dụng khi bạn biết chính xác địa chỉ IP của thiết bị.\n"
"                            <br/>\n"
"                            Ví dụ: 192.168.1.100"

#. module: sv_biometric_connection
#: model_terms:ir.ui.view,arch_db:sv_biometric_connection.biometric_device_details_form_view
msgid ""
"<strong>Hostname + DNS Connection:</strong>\n"
"                            <br/>\n"
"                            Use this when each device has a unique hostname under the same domain.\n"
"                            <br/>\n"
"                            Example: device1.company.ddns.net\n"
"                            <br/>\n"
"                            (Hostname: device1, DNS Domain: company.ddns.net)"
msgstr ""
"<strong>Kết nối Hostname + DNS:</strong>\n"
"                            <br/>\n"
"                            Sử dụng khi mỗi thiết bị có tên host riêng biệt dưới cùng một tên miền.\n"
"                            <br/>\n"
"                            Ví dụ: device1.company.ddns.net\n"
"                            <br/>\n"
"                            (Hostname: device1, DNS Domain: company.ddns.net)"

