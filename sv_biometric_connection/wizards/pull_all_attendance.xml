<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pull_all_attendance_form" model="ir.ui.view">
        <field name="name">pull.all.attendance.form</field>
        <field name="model">pull.all.attendance</field>
        <field name="arch" type="xml">
            <form string="Pull Attendance Data">
                <sheet>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_pull_attendance" type="object" string="Pull Attendance"
                            class="btn-primary" icon="fa-solid fa-eye"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pull_all_attendance" model="ir.actions.act_window">
        <field name="name">Pull Attendance</field>
        <field name="res_model">pull.all.attendance</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
